    "Count one tracker from your Home Screen or Lock Screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count one tracker from your Home Screen or Lock Screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähle einen Zähler direkt vom Home- oder Sperrbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta un contador desde la pantalla de inicio o de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez un compteur depuis l'écran d'accueil ou l'écran verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta un contatore dalla schermata Home o dalla schermata di blocco."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekran'dan veya Kilit Ekranı'ndan bir sayacı say."
          }
        }
      }
    },
    "Your trackers in one list, each with a + button.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trackers in one list, each with a + button."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Zähler in einer Liste, jeweils mit einer +-Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus contadores en una lista, cada uno con un botón +."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos compteurs dans une liste, chacun avec un bouton +."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi contatori in un elenco, ognuno con un pulsante +."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm sayaçların tek listede, her birinde + düğmesi."
          }
        }
      }
    },
